# Firebase (Auth + Firestore) — crea tu proyecto en https://console.firebase.google.com
# Project Settings > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary — subida de imágenes GRATUITA (sin tarjeta) https://cloudinary.com
# Dashboard > Cloud name  +  Settings > Upload > Upload presets (unsigned)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ── Solo servidor (funciones en api/*.ts, NO llevan prefijo VITE_) ──────────

# Firebase Admin SDK — Firebase Console > Configuración del proyecto >
# Cuentas de servicio > Generar nueva clave privada. Pega el JSON completo
# como una sola línea. Solo lo usa api/academia-admin.ts (gestión de alumnos).
FIREBASE_SERVICE_ACCOUNT=

# Envío de correos (kit gratuito, solicitudes del portal, briefs, alumnos)
# vía Gmail SMTP — Contraseña de aplicación de alma.directivo@gmail.com
# (myaccount.google.com/apppasswords, requiere verificación en 2 pasos)
GMAIL_APP_PASSWORD=

# Correo al que llegan las notificaciones internas (nuevo lead, solicitud…)
ADMIN_EMAIL=alma.directivo@gmail.com

# Alternativa/complemento a Gmail para el kit gratuito — resend.com
RESEND_API_KEY=
RESEND_FROM_DOMAIN=
