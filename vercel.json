{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "brief.almaagenciacreativa.com" }],
      "destination": "/brief",
      "permanent": false
    },
    {
      "source": "/brief",
      "has": [{ "type": "host", "value": "almaagenciacreativa.com" }],
      "destination": "https://brief.almaagenciacreativa.com",
      "permanent": true
    },
    {
      "source": "/brief",
      "has": [{ "type": "host", "value": "www.almaagenciacreativa.com" }],
      "destination": "https://brief.almaagenciacreativa.com",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ]
}
