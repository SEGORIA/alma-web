{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "brief.almaagenciacreativa.com" }],
      "destination": "/brief",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ]
}
